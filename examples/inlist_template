! EB's updates (mod4)

&star_job
  ! see star/defaults/star_job.defaults

  ! begin with a pre-main sequence model
    create_pre_main_sequence_model = .true.
    
  !  load_saved_model = .true.
  !  load_model_filename = 'ZAMS_1.5M.mod'
      
  ! save a model at the end of the run
    save_model_when_terminate = .true.
    save_model_filename = 'TAMS_0.70.mod'


  ! network
    change_initial_net = .true.
    new_net_name = 'pp_and_cno_extras.net'

  ! display on-screen plots
    pgstar_flag = .false.


  T9_weaklib_full_off = 0.0001d0
  T9_weaklib_full_on = 0.00011d0


  pre_ms_relax_to_start_radiative_core = .false.    
  pre_ms_T_c = 5d5

/ ! end of star_job namelist


&eos
  ! eos options
  ! see eos/defaults/eos.defaults

/ ! end of eos namelist


&kap
  ! kap options
  ! see kap/defaults/kap.defaults
  use_Type2_opacities = .true.
  Zbase = 0.02

/ ! end of kap namelist


&controls
    
  ! see star/defaults/controls.defaults
    write_pulse_data_with_profile = .true.
    pulse_data_format = 'GYRE'
    add_atmosphere_to_pulse_data = .false.
    add_center_point_to_pulse_data = .true.
    keep_surface_point_for_pulse_data = .true.
    add_double_points_to_pulse_data = .true. ! GYRE can handle this now

    report_ierr = .true.

  ! starting specifications
    initial_mass = 0.7000 ! in Msun units
    initial_z = 0.0200
    initial_y = 0.2700

  ! when to stop


  ! stop when the center mass fraction of h1 drops below this limit
    xa_central_lower_limit_species(1) = 'h1'
    xa_central_lower_limit(1) = 1d-6 ! for TAMS
   

  ! rotation

  ! element diffusion
    do_element_diffusion = .false. 
    atm_option = 'T_tau'
    atm_T_tau_relation = 'Eddington'
    atm_T_tau_opacity = 'varying'
    atm_build_tau_outer = 1d-4

  ! Mass Loss/Wind
   ! cool_wind_RGB_scheme = 'Reimers' 
   ! Reimers_scaling_factor = 0.1
   ! cool_wind_AGB_scheme = 'Blocker' 
   ! Blocker_scaling_factor = 0.5
   ! RGB_to_AGB_wind_switch = 1d-4

  ! only use the cool_wind_scheme 
   ! cool_wind_full_on_T = 1d10 !K 
   ! hot_wind_full_on_T = 1.1d10 !K 
   ! hot_wind_scheme = ''

  ! mlt
    use_Ledoux_criterion = .true.
    alpha_semiconvection = 1d0
    mixing_length_alpha = 2.0

  ! mixing
    overshoot_scheme(1) = 'exponential'
    overshoot_zone_type(1) = 'any'
    overshoot_zone_loc(1) = 'core'
    overshoot_bdy_loc(1) = 'any'

    overshoot_f(1) = 0.01
    overshoot_f0(1) = 0.005
      
    overshoot_scheme(2) = 'exponential'
    overshoot_zone_type(2) = 'any'
    overshoot_zone_loc(2) = 'shell'
    overshoot_bdy_loc(2) = 'any'

    overshoot_f(2) = 0.005
    overshoot_f0(2) = 0.001

    overshoot_D_min = 1d-6

  ! timesteps

    ! Global Hammer
    time_delta_coeff = 1d0

   varcontrol_target = 1d-4
   delta_lgL_limit = 1d-3
   delta_lgR_limit = 1d-3 
   delta_lgL_He_limit = 5d-3
   delta_HR_limit = 1d-3

   ! limit for changes in central abundances, RECOMMENDED 0.001d0 for all
   delta_XH_cntr_limit = 0.001d0
   delta_XHe_cntr_limit = 0.001d0
   delta_XC_cntr_limit = 0.001d0
   delta_XO_cntr_limit = 0.001d0

   delta_lgRho_cntr_limit = 1d-3
   delta_lgT_cntr_limit = 1d-3
   delta_lgT_cntr_limit_only_after_near_zams = .false.
   delta_lgT_max_limit = 1d-3
   delta_lgT_max_limit_lgT_min = 6d0

   dX_nuc_drop_limit = 1d-3

  ! mesh

    ! Global Hammer
   mesh_delta_coeff = 1d0
   max_allowed_nz = -1


   ! some additional function weights
   R_function_weight = 40
   R_function3_weight = 40 
   M_function_weight = 40 
   log_tau_function_weight = 40  

   xa_function_species(2) = 'he3'
   xa_function_weight(2) = 1d3
   xa_function_param(2) = 1	

   ! max zone size is 1/max_dq in m/mstar
   max_dq = 1d-3


  ! solver
     ! options for energy conservation (see MESA V, Section 3)
     energy_eqn_option = 'dedt'
     use_gold_tolerances = .true.
     use_gold2_tolerances = .true.


  ! output
    max_num_profile_models = 100000
    history_interval = 1
    profile_interval = -1
    terminal_interval = 10
    log_directory = 'M_0.700_Y_0.270_Z_0.020_alpha_2.00'

/ ! end of controls namelist

